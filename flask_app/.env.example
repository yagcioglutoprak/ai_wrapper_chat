# Flask
SECRET_KEY=change-me-in-production
FLASK_DEBUG=1

# Database — SQLite locally (default), PostgreSQL on Azure
# DATABASE_URL=postgresql://user:password@yourserver.postgres.database.azure.com:5432/mydb

# Azure Blob Storage (optional — falls back to local filesystem)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=app-files

# AI API server URL (Anthropic-compatible)
# API_SERVER_URL=http://127.0.0.1:8000
